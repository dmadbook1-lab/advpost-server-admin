# Copy to .env and fill values. .env is gitignored — never commit secrets.

# App
# Web on localhost → development (DB_LOCAL_*). Production server → set CI_ENV=production.
CI_ENV=development
BASE_URL=https://admin.advpost.in/
BASE_URL_LOCAL=http://localhost:8080/
ENCRYPTION_KEY=

# Production database
DB_HOST=your-production-db-host
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=advpost_db
DB_DRIVER=mysqli
DB_CHARSET=utf8
DB_COLLATION=utf8_general_ci

# Local database
DB_LOCAL_HOST=127.0.0.1
DB_LOCAL_USERNAME=root
DB_LOCAL_PASSWORD=
DB_LOCAL_DATABASE=adbookuser_adbookuser
DB_LOCAL_DRIVER=mysqli
DB_LOCAL_CHARSET=utf8
DB_LOCAL_COLLATION=utf8_general_ci

# AWS S3 (fallback if aws_credential table is empty)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=advpost
AWS_URL=https://advpost.s3.ap-south-1.amazonaws.com

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
