# AdvPost server — the ONLY env file. Never commit .env (copy .env.example to start).
#
# Environment is picked automatically:
#   http://localhost / 127.0.0.1 / *.local  → development  (DB_LOCAL_*, BASE_URL_LOCAL)
#   any other host (admin.advpost.in)       → production   (DB_*, BASE_URL)
# CI_ENV below is only used by CLI scripts in bin/ (cron). Use production on the server.
# A CI_ENV set in the shell / vhost overrides everything, e.g. CI_ENV=production php bin/x.php
CI_ENV=development

# App
BASE_URL=https://admin.advpost.in/
BASE_URL_LOCAL=http://localhost:8080/
ENCRYPTION_KEY=

# Production database (used when environment = production)
DB_HOST=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=advpost_db
DB_DRIVER=mysqli
DB_CHARSET=utf8
DB_COLLATION=utf8_general_ci

# Local database (used when environment = development)
DB_LOCAL_HOST=127.0.0.1
DB_LOCAL_USERNAME=root
DB_LOCAL_PASSWORD=
DB_LOCAL_DATABASE=adbookuser_adbookuser
DB_LOCAL_DRIVER=mysqli
DB_LOCAL_CHARSET=utf8
DB_LOCAL_COLLATION=utf8_general_ci

# AWS S3 (fallback if aws_credential table is empty)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=advpost
AWS_URL=https://advpost.s3.ap-south-1.amazonaws.com

# Shared secret for media service -> PHP generation log ingest (X-Media-Log-Key)
MEDIA_LOG_SECRET=

# Razorpay — currently rzp_test_ keys; switch to rzp_live_ before taking real payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set from Razorpay Dashboard -> Webhooks (webhook.php rejects events without it)
RAZORPAY_WEBHOOK_SECRET=

# SMS (Fast2SMS) — OTP delivery. Required for store_otp.
FAST2SMS_API_KEY=
